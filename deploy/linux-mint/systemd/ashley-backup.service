[Unit]
Description=Ashley daily break-glass backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/project-ashley/apps/agent-service
EnvironmentFile=%h/.composer-assistant/.env
ExecStart=/usr/bin/node dist/scripts/backup-daily.js
NoNewPrivileges=yes

[Install]
WantedBy=default.target
