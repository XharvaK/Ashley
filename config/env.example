# Copy to ~/.composer-assistant/.env — never commit real keys
# This example contains only current agent and direct Sandbox V2 settings.

# ── Providers [agent] ────────────────────────────────────────────────────────
# Primary Mistral credential for the Thought lane. The secondary credential is
# optional and dormant until an account-scoped, definitive primary failure.
MISTRAL_API_KEY=
MISTRAL_API_KEY_SECONDARY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
MISTRAL_REASONING_EFFORT=none
MISTRAL_CHAT_TEMPERATURE=0.65
# Copy the current organization/model limits from Mistral Studio.
MISTRAL_REQUESTS_PER_SECOND=1
MISTRAL_TOKENS_PER_MINUTE=100000

# Groq Expression fallback and any separately declared utility routes.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b

# NVIDIA NIM Expression and utility routes use the shared provider contract.
# NIM_API_KEY=
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Cloudflare Workers AI Thought route. Both values are required on Mint.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Command Code Provider API backs the Muse Thought route and isolated CLI worker.
# This credential is shared by the API adapter and the ordinary CLI process.
# COMMAND_CODE_API_KEY=

# Stable Host-owned routing-locality identifier for the exact Cloudflare
# DeepSeek Thought route (x-session-affinity transport header). Unset means
# affinity is intentionally disabled. When set, must be 16-128 chars of
# [A-Za-z0-9_-]; any other defined value fails boot validation. Opaque
# operator value only: never a Discord/owner/conversation ID, never a
# credential, never model-generated. Stable across restarts; rotate only by
# operator action or provider/model route migration. Never logged raw.
# ASHLEY_CLOUDFLARE_THOUGHT_AFFINITY_ID=

# Optional override; defaults to the current Git commit when available.
ASHLEY_RELEASE_ID=

# ── Discord [agent] ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ALLOWED_CHANNELS=
DISCORD_GUILD_ID=

# Optional Owner-set Discord bot principal for person-wide bot DM admission.
# Empty means bot DMs remain capture/quarantine only; room-local bot traffic
# uses trusted-room authority and does not require this value.
RA_BOT_DM=

# Relationship-admission switches. Every key below fails closed: only the
# exact values true or 1 enable a boolean gate; missing or malformed values
# disable it. These settings do not grant authority by themselves.
RA_COMMITMENTS=false
RA_DM_PUBLICATION=false
RA_DM_COGNITION=false
RA_SOCIAL_CAPTURE=false
RA_ROOM_SEED_ACTIVE=false

# Exact Discord channel used by room publication. Empty or whitespace-only
# values disable room publication; it is also gated by RA_ROOM_SEED_ACTIVE.
RA_ROOM_PUBLICATION=

# External DM principal. Empty or whitespace-only values disable external-DM
# cognition and admission even when their boolean switches are enabled.
RA_DM_PRINCIPAL=

MEMORY_OWNER_ID=

# IANA time zone for Ashley's clock (local time and weekday in Thought input).
# Empty keeps the fixed UTC+3 default.
ASHLEY_OWNER_TIME_ZONE=

# Afterglow: Ashley reflects on a conversation 30 minutes after it goes quiet
# (episode + thread story). On by default; "false" turns it off.
ASHLEY_AFTERGLOW_ENABLED=true

AGENT_PORT=3710
AGENT_BIND_HOST=127.0.0.1
AGENT_SERVICE_URL=http://127.0.0.1:3710

# ── Nuclear Identity→State→Agency (nuclear.db) [agent] ───────────────────────
PROACTIVE_ENABLED=true
PROACTIVE_MAX_PER_DAY=8
PROACTIVE_MIN_IDLE_HOURS=2
ASHLEY_REFLECTION_MODE=observe
ASHLEY_COGNITION_MODE=observe
COGNITION_DISPATCH_INTERVAL_SEC=30
# Discord bot scheduler poll interval (minutes). Code default is 60; a
# production env override wins and is preserved until Owner-authorized
# periodic activation (verify the live value at deployment time).
PROACTIVE_CHECK_INTERVAL_MIN=60

# Ashley's own time (Growth V1 AWAKE). Default OFF / fail closed: only an
# explicit `true` or `1` enables it. When on, Ashley gets a private pass every
# 3 hours (jittered ±20 min; the first 20 min after start), after any due
# afterglow and never while the Owner conversation is live. It replaced the
# old 4 h periodic schedule. Due authored future triggers are unaffected.
PERIODIC_COGNITION_ENABLED=false

# Developmental observability collection mode. Fail-closed values (including
# unset or malformed values) are off. `rich` is required only for the bounded
# P3 qualification/field period; raw projected debug still requires explicit
# per-occurrence owner enablement and the 28-day retention cap.
ASHLEY_OBSERVABILITY_MODE=off

CURIOSITY_ENABLED=true
# Existing Host-only Tavily public search transport. Leave empty to keep
# web.search unavailable. The key is never exposed to Thought or logged.
TAVILY_API_KEY=
CURIOSITY_LOOKUP_ENABLED=true
CURIOSITY_TAVILY_MONTHLY_CREDITS=1000
CURIOSITY_LOOKUP_PER_DAY=40

GIPHY_API_KEY=
TENOR_API_KEY=
GIF_ENABLED=true
GIF_COOLDOWN_SEC=90

# ── Visible Expression fallback (Wave 3, active) [agent] ──────────────────────
# When the primary Mistral dispatch fails on an eligible turn, retry once via
# the minimal-profile ashley_expression_fallback (Groq) route. ON by default;
# set false to opt out.
# ASHLEY_EXPRESSION_FALLBACK=false
# ASHLEY_EXPRESSION_FALLBACK_RECENT_TURNS=6
# Decision kinds that must never leave the Mistral lane (comma-separated).
# ASHLEY_EXPRESSION_MISTRAL_ONLY_KINDS=

# ── Sandbox V2 direct execution [agent] ─────────────────────────────────────
# Direct, unprivileged Bubblewrap execution is the only current sandbox path.
# The lifecycle switch is fail-closed by default. Project roots are host-owned
# and read-only to model code.
ASHLEY_SANDBOX_ENGINEERING_LIFECYCLE_ENABLED=false
ASHLEY_SANDBOX_PROJECT_REGISTRY=~/.composer-assistant/sandbox/project-roots.json

# Command Code CLI worker. Enabled only after exact-host qualification.
# The worker uses a Host-maintained, self-contained runtime root so the
# Bubblewrap mount does not expose the host home directory.
ASHLEY_COMMAND_CODE_WORKER_ENABLED=false
ASHLEY_COMMAND_CODE_RUNTIME_ROOT=~/.composer-assistant/sandbox/command-code/current
# ASHLEY_COMMAND_CODE_BIN=~/.composer-assistant/sandbox/command-code/current/bin/command-code
# ASHLEY_COMMAND_CODE_NODE=~/.composer-assistant/sandbox/command-code/current/bin/node
ASHLEY_COMMAND_CODE_BWRAP_BIN=/usr/bin/bwrap
ASHLEY_COMMAND_CODE_MIN_VERSION=1.64.0
ASHLEY_COMMAND_CODE_QUALIFICATION_STATE=~/.composer-assistant/sandbox/command-code-state.json
# Off by default (Owner, 2026-09-29): updates run only when Alex turns this on.
# Installs skip upstream install scripts; the candidate is qualified in the sandbox.
ASHLEY_COMMAND_CODE_UPDATE_ENABLED=false
ASHLEY_COMMAND_CODE_UPDATE_INTERVAL_HOURS=6

DISCORD_PACE_ENABLED=true
DISCORD_REACT_POLICY_ENABLED=true
