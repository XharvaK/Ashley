{
  "name": "project-ashley",
  "private": true,
  "version": "0.2.0",
  "description": "Project Ashley — Discord companion (Mistral + nuclear local memory)",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:discord": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -Discord",
    "dev:agent": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1 -AgentOnly",
    "start:ashley": "powershell -ExecutionPolicy Bypass -File scripts/mint/remote-update.ps1",
    "stop:ashley": "powershell -ExecutionPolicy Bypass -File scripts/start-production.ps1 -Stop",
    "start:ashley:windows": "powershell -ExecutionPolicy Bypass -File scripts/start-production.ps1 -AllowWindows",
    "build:agent": "npm run build --prefix apps/agent-service",
    "build:observer": "npm run build --prefix apps/observer-exporter",
    "build:discord": "npm run build --prefix apps/discord-bot",
    "phase0": "powershell -ExecutionPolicy Bypass -File scripts/phase0/run-all.ps1",
    "phase0:offline": "powershell -ExecutionPolicy Bypass -File scripts/phase0/run-all.ps1 -Tier offline",
    "phase0:agent": "powershell -ExecutionPolicy Bypass -File scripts/phase0/run-all.ps1 -Tier agent",
    "phase0:mistral": "node scripts/phase0/test-mistral.mjs",
    "test": "npm test --prefix apps/agent-service",
    "test:current-product": "node scripts/testing/run-current-gate.mjs current-product",
    "test:current-sandbox-v2": "node scripts/testing/run-current-gate.mjs current-sandbox-v2",
    "test:current-deployment": "node scripts/testing/run-current-gate.mjs current-deployment",
    "test:current-release": "npm run test:current-product && npm run test:current-sandbox-v2 && npm run test:current-deployment",
    "test:full-current": "node scripts/testing/run-current-gate.mjs full-current",
    "test:scale": "npm run test:scale --prefix apps/agent-service",
    "test:observer": "npm test --prefix apps/observer-exporter",
    "test:recall": "powershell -ExecutionPolicy Bypass -File scripts/phase0/run-all.ps1 -Tier agent",
    "config": "powershell -ExecutionPolicy Bypass -File scripts/install-config.ps1",
    "eval:replay": "powershell -ExecutionPolicy Bypass -File scripts/persona-eval/run-isolated.ps1",
    "eval:full": "powershell -ExecutionPolicy Bypass -File scripts/persona-eval/run-full.ps1",
    "verify:status": "node scripts/stabilization/verify-status.mjs --check",
    "eval:deterministic": "node scripts/stabilization/eval-deterministic.mjs",
    "test:stabilization": "node --test scripts/stabilization/*.test.mjs scripts/mint/coherent-activation.test.mjs",
    "assurance:10c": "node scripts/stabilization/audit-10c.mjs --check-only",
    "audit:mint-docs": "node scripts/stabilization/audit-mint-docs.mjs --check-only"
  }
}
